{
  "name": "ib-toolkit",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "turbo run typecheck test lint:arch && biome check .",
    "dev:template": "bun --filter @inbeat/template dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "storybook": "bun --filter @inbeat/ui storybook",
    "build-storybook": "turbo run build-storybook",
    "pack:local": "bun scripts/pack-local.ts",
    "sync": "bun scripts/sync-local.ts",
    "release": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.5",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
