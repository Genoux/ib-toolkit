{
  "name": "@inbeat/config",
  "version": "0.7.1",
  "description": "Shared tsconfig, Biome, dependency-cruiser, Vitest and commitlint presets for inBeat apps",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "tsconfig",
    "biome.json",
    "dependency-cruiser.cjs",
    "vitest.js",
    "vitest.d.ts",
    "commitlint.js"
  ],
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/compiled.json": "./tsconfig/compiled.json",
    "./biome": "./biome.json",
    "./dependency-cruiser": "./dependency-cruiser.cjs",
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./commitlint": "./commitlint.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.5",
    "vitest": "^4"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genoux/ib-toolkit.git",
    "directory": "packages/config"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED"
}
