{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/template/**",
        "!$TURBO_ROOT$/apps/template/**/*.tsbuildinfo",
        "!$TURBO_ROOT$/apps/template/**/node_modules/**",
        "!$TURBO_ROOT$/apps/template/.next/**",
        "!$TURBO_ROOT$/apps/template/.turbo/**",
        "!$TURBO_ROOT$/apps/template/coverage/**"
      ],
      "outputs": ["template/**"]
    }
  }
}
