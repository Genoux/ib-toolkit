{
  "name": "@inbeat/core",
  "version": "0.1.0",
  "description": "Framework-free primitives for inBeat apps: errors, results, logging, env fragments, signed events",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./errors": "./src/errors/index.ts",
    "./result": "./src/result.ts",
    "./logger": "./src/logger.ts",
    "./env": "./src/env.ts",
    "./email": "./src/email.ts",
    "./events": "./src/events.ts",
    "./signature": "./src/signature.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@inbeat/config": "workspace:*",
    "vitest": "^4.1.1",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genoux/ib-toolkit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "UNLICENSED"
}
