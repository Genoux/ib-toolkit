# Required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Verified emails on these domains resolve to admin; everyone else is a member.
ADMIN_EMAIL_DOMAINS=inbeat.agency

# Optional
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
# Origin for links that leave the app; Vercel provides VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000
# Set by Vercel: VERCEL_ENV. Mirror it as NEXT_PUBLIC_VERCEL_ENV for browser Sentry events.
NEXT_PUBLIC_VERCEL_ENV=

# Build-time only (source map upload in next.config.ts)
SENTRY_ORG=inbeat-67
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
