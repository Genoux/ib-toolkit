{
  "name": "@inbeat/next",
  "version": "0.9.1",
  "description": "Next.js App Router building blocks for inBeat apps: actions, routes, security, observability",
  "type": "module",
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "exports": {
    "./action": {
      "types": "./dist/action.d.ts",
      "default": "./dist/action.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "default": "./dist/route.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "default": "./dist/capture.js"
    },
    "./clerk-webhook": {
      "types": "./dist/clerk-webhook.d.ts",
      "default": "./dist/clerk-webhook.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "default": "./dist/maintenance.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "default": "./dist/rate-limit.js"
    },
    "./security-headers": {
      "types": "./dist/security-headers.d.ts",
      "default": "./dist/security-headers.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "default": "./dist/sentry.js"
    },
    "./sentry-client": {
      "types": "./dist/sentry-client.d.ts",
      "default": "./dist/sentry-client.js"
    },
    "./safe-redirect": {
      "types": "./dist/safe-redirect.d.ts",
      "default": "./dist/safe-redirect.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inbeat/core": "workspace:^",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "@clerk/nextjs": "^7",
    "@neondatabase/serverless": "^1",
    "@sentry/nextjs": "^10",
    "drizzle-orm": ">=0.44",
    "geist": "^1",
    "next": ">=16",
    "react": "^19",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@clerk/nextjs": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clerk/nextjs": "^7.0.6",
    "@inbeat/config": "workspace:^",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "^10",
    "@types/react": "^19",
    "drizzle-orm": "^0.45.1",
    "geist": "^1.7.2",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vitest": "^4.1.1",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genoux/ib-toolkit.git",
    "directory": "packages/next"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED"
}
