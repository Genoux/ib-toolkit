{
  "name": "@inbeat/standards",
  "version": "0.9.4",
  "description": "Agent standards for inBeat apps: managed AGENTS.md block, skills under .agents/skills, ib CLI",
  "type": "module",
  "bin": {
    "ib": "./src/cli.ts"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "agents",
    "skills",
    "template",
    "!src/**/*.test.ts",
    "!template/**/node_modules",
    "!template/.next",
    "!template/.turbo",
    "!template/coverage",
    "!template/.vercel",
    "!template/next-env.d.ts",
    "!template/*.tsbuildinfo",
    "!template/**/.env",
    "!template/**/.env.[!e]*"
  ],
  "exports": {
    "./sync": "./src/sync.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run"
  },
  "devDependencies": {
    "@inbeat/config": "workspace:^",
    "vitest": "^4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genoux/ib-toolkit.git",
    "directory": "packages/standards"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
