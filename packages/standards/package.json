{
  "name": "@inbeat/standards",
  "version": "0.2.0",
  "description": "Agent standards for inBeat apps: managed AGENTS.md block, Cursor/Claude skills and rules, ib CLI",
  "type": "module",
  "bin": {
    "ib": "./src/cli.ts"
  },
  "files": [
    "src",
    "agents",
    "skills",
    "template",
    "addons",
    "!src/**/*.test.ts",
    "!src/__snapshots__",
    "!src/test"
  ],
  "exports": {
    "./sync": "./src/sync.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bun scripts/build-template.ts"
  },
  "devDependencies": {
    "@inbeat/config": "workspace:^",
    "vitest": "^4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genoux/ib-toolkit.git",
    "directory": "packages/standards"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "UNLICENSED"
}
